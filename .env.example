# ---- Database (local SQLite — the production DB for this personal tool) ----
AGENT_DATABASE_URL=sqlite:///./data/agent.db

# ---- LLM provider ----
# This build runs on Google Gemini. Provider is auto-detected from whichever
# key is set below; you can override it explicitly (anthropic | gemini).
AGENT_LLM_PROVIDER=gemini

# Model — Gemini Flash is the cheap default for this tool. Leave blank to use
# the provider default (gemini-3.1-flash), or pin an exact Flash model id here.
# AGENT_LLM_MODEL=gemini-3.1-flash

# ---- Provider key (REQUIRED — set the Gemini key) ----
AGENT_GEMINI_API_KEY=
# AGENT_ANTHROPIC_API_KEY=   # unused in this build

# ---- Agent behaviour ----
# Max write-code -> run -> retry attempts before surfacing a clean error.
AGENT_MAX_STEPS=3
# Number of sample rows shown to the LLM (never the full dataset).
AGENT_SAMPLE_ROWS=5
# Max upload size in MB (CSV up to ~100MB).
AGENT_MAX_UPLOAD_MB=100
# Sandbox bounds for generated-pandas execution.
AGENT_SANDBOX_TIMEOUT_S=30
AGENT_SANDBOX_MEM_MB=2048

# ---- Server ----
PORT=8001
